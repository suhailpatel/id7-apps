{
  "id": "ixpulse",
  "title": "iX Pulse",
  "description": "EV driving HUD and cluster with speed, range, observed average consumption and navigation directions. G08 validation pending.",
  "version": "0.1.7",
  "vendor": "custom",
  "loggingId": "OAXP",
  "iconGlyph": "bolt",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "_optional": "HUD yields when navigation state is unavailable",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "conclusiveDart": "rs",
      "_broadcasts": [
        "activeRouteChanged"
      ]
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "_optional": "HUD yields when navigation state is unavailable",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "_instances": "AndroidAutoProjectedManagerInst1",
      "_optional": "HUD yields when navigation state is unavailable",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.dass.driverassistanceapplications.TrafficSignDisplayControl": {
      "_instances": "1",
      "_optional": "Reported speed limit; unavailable without fresh valid notifications",
      "displaySpeedLimitAndNoPassingRestriction": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "_instances": "1",
      "_optional": "Reported electric range",
      "displayRangeElectricVehicle": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_instances": "1",
      "_optional": "Explicit distance unit for electric range",
      "UnitBN2020": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_instances": "Main_Instance",
      "_optional": "Readable phone navigation turns",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_instances": "1",
      "_optional": "Reported selector position",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_instances": "1",
      "_optional": "Explicit B programme when available",
      "dataDisplayGearbox": "s"
    }
  },

{
  "id": "ixobservatory",
  "title": "iX Observatory",
  "description": "Read-only battery, electrical and thermal observatory for BMW iDrive 7. G08 diagnostic candidates require validation.",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OK2P",
  "iconGlyph": "iO",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "iX Observatory",
      "buttons": [
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_NEXT",
          "Next page"
        ],
        [
          "BTN_DETAIL",
          "Chart window / next cells"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {

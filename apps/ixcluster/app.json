{
  "id": "ixcluster",
  "title": "iX Cluster",
  "description": "Full-screen instrument cluster themes for the iX3 (M view, Sport, Minimal, Cruise, Ribbon, GT3, M, Vector, Track, Drag, Rally, Retro 80s, Dyno), with battery power and regen, charge level, battery temperature, electric range, tyres and a 0-60 timer. G08 validation pending.",
  "version": "0.1.2",
  "vendor": "custom",
  "loggingId": "OAXL",
  "iconGlyph": "gauge",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "B (regenerative braking) next to D"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "statusChargeOfBatteryHybrid": "rs",
      "_optional": "Charge level as the car displays it (0.5 % per bit)"
    },
    "de.bmw.infotainment.KombiIF": {
      "displayRangeElectricVehicle": "rs",
      "_optional": "Reported electric range"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "UnitBN2020": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s",
      "_optional": "the car switching off: no new layer while it does (cluster-render's switch-off guard)"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "_optional": "Tyre pressure and temperature (Track and readouts); polled only while reads are allowed"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "the car's pressure and temperature units, for the tyre readouts"
    },
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": {
      "playerMetadata": "rs",
      "trackProgress": "rs",
      "_optional": "now playing (title, artist, progress) in the Vector theme's music panel"
    }
  },

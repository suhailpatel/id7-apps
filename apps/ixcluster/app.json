  "config": {
    "target": "panel",
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "utcOffsetMinutes": null,
    "waze": {
      "comment": "Show Waze map inside the theme (shared/waze.js): waze-on-cluster's status file (read every second) and its control socket (one short 'start' command, then closed). Paths from waze-on-cluster 0.9.3.",
      "status": "/run/waze-on-cluster/status.json",
      "control": "/dev/shm/waze-on-cluster/ctl.sock"
    },
    "_comment": "target panel: the whole 1920x720 instrument cluster, drawn over BMW's gauges through cluster-render. Battery groups are iX Pulse's read-only UDS candidates (fully electric E54D/E561/E5CE first), not validated on this G08.",
    "ecu": 7,
    "powerSign": -1,
    "groups": {
      "hvV": [
        {
          "did": "E54D",
          "timeoutMs": 600,
          "fields": {
            "v": {
              "bytes": 2,
              "factor": 0.01,
              "min": 150,
              "max": 500
            }
          },
          "note": "fully electric (fifth-generation eDrive) pack voltage: confirmed on the iX, likely the iX3. OBDb/BMW-iX3 captures (CC BY-SA 4.0), via upstream eDrive 2.10.0; not yet validated on this G08"
        },
        {
          "did": "DDB4",
          "timeoutMs": 600,
          "fields": {
            "v": {
              "bytes": 2,
              "factor": 0.01,
              "min": 150,
              "max": 500
            }
          },
          "note": "confirmed on the X5 45e"
        },
        {
          "did": "DD68",
          "fields": {
            "v": {
              "bytes": 2,
              "factor": 0.01,
              "min": 150,
              "max": 500
            }
          }
        },
        {
          "did": "DD66",
          "fields": {
            "v": {
              "bytes": 2,
              "factor": 0.01,
              "min": 150,
              "max": 500
            }
          }
        },
        {
          "did": "DDEF",
          "fields": {
            "v": {
              "bytes": 2,
              "factor": 1,
              "min": 150,
              "max": 500
            }
          }
        }
      ],
      "hvI": [
        {
          "did": "E561",
          "timeoutMs": 600,
          "fields": {
            "a": {
              "bytes": 4,
              "factor": 0.01,
              "signed": true,
              "min": -2000,
              "max": 2000
            }
          },
          "note": "fully electric pack current, same layout and direction as DD69 (negative = out of the pack). OBDb/BMW-iX3 captures (CC BY-SA 4.0), via upstream eDrive 2.10.0; not yet validated on this G08"
        },
        {
          "did": "DD69",
          "timeoutMs": 600,
          "fields": {
            "a": {
              "bytes": 4,
              "factor": 0.01,
              "signed": true,
              "min": -2000,
              "max": 2000
            }
          }
        }
      ],
      "soc": [
        {
          "did": "E5CE",
          "fields": {
            "pct": {
              "bytes": 2,
              "factor": 0.01,
              "min": 0,
              "max": 100
            }
          },
          "note": "fully electric charge level in 0.01 %, then the lowest and highest cell's charge; displayed vs physical SOC unverified. OBDb/BMW-iX3 captures (CC BY-SA 4.0), via upstream eDrive 2.10.0; not yet validated on this G08"
        },
        {
          "did": "DDBC",
          "fields": {
            "pct": {
              "bytes": 2,
              "factor": 0.1,
              "min": 0.5,
              "max": 100
            }
          },
          "note": "min 0.5: OBDb iX3 captures answer zero here, which must not read as an empty battery"
        }
      ],
      "cellT": [
        {
          "did": "DDC0",
          "fields": {
            "min": {
              "at": 0,
              "bytes": 2,
              "factor": 0.01,
              "signed": true,
              "min": -40,
              "max": 80
            },
            "max": {
              "at": 2,
              "bytes": 2,
              "factor": 0.01,
              "signed": true,
              "min": -40,
              "max": 80
            },
            "avg": {
              "at": 4,
              "bytes": 2,
              "factor": 0.01,
              "signed": true,
              "min": -40,
              "max": 80
            }
          }
        }
      ]
    },
    "provenance": "Inherited iXDrive/eDrive battery diagnostic candidates. Not validated on G08 iX3."
  }
}

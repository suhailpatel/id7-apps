{
  "id": "tyrewatch",
  "title": "TyreWatch",
  "description": "Four-wheel pressure, temperature, vehicle targets and cool-reading history for iDrive 7. G08 telemetry requires validation.",
  "version": "0.1.2",
  "vendor": "custom",
  "loggingId": "OOJY",
  "iconGlyph": "TW",
  "signals": {
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TyreWatch",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_WHEEL",
          "Next wheel"
        ],
        [
          "BTN_NEWER",
          "Newer"
        ],
        [
          "BTN_OLDER",
          "Older"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
